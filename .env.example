# Copy only for documentation. Recommended: run `node dist/cli.js init`
# to generate a real .env with a cryptographically random bearer token.
# Never commit the resulting .env file or paste its token.

# Bridge HTTP server — keep on loopback when using a local OAuth gateway.
OPENCODE_BRIDGE_HOST=127.0.0.1
OPENCODE_BRIDGE_PORT=8787
# Set false if a gateway expects the Bridge at a fixed port.
OPENCODE_BRIDGE_AUTO_PORT=false
OPENCODE_BRIDGE_ALLOWED_HOSTS=127.0.0.1,localhost

# Required for authenticated MCP access. Generated by `init` in the private .env.
OPENCODE_BRIDGE_TOKEN=
# URLs and logs should not contain tokens.
OPENCODE_BRIDGE_ALLOW_QUERY_TOKEN=false

# Replace with existing, narrowly scoped project directories.
# Windows: C:\Projects\repo-one;D:\Work\repo-two
# macOS/Linux: /Users/you/Projects/repo-one:/Users/you/Projects/repo-two
OPENCODE_BRIDGE_ALLOWED_ROOTS=REPLACE_WITH_YOUR_PROJECT_PATH

# Tool permission policy: safest defaults.
# In read+send mode, prompts MAY cause OpenCode to edit files or run commands.
OPENCODE_BRIDGE_READ_ONLY=true
OPENCODE_BRIDGE_ALLOW_SEND_MESSAGE=false

# Reuse already-running OpenCode v2 background service, including its sessions.
OPENCODE_BRIDGE_USE_SERVICE=true
# If the service file is elsewhere, specify the path to it privately:
# OPENCODE_BRIDGE_SERVICE_CONFIG=C:\Users\you\.local\state\opencode\service.json
# Or use a known existing server URL:
# OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=  # only for a server without service-file credentials

# Bridge itself is local; HTTPS/OAuth Gateway is a separate component.
OPENCODE_BRIDGE_TUNNEL=none
# Other supported options: cloudflare, tailscale (secure remote exposure first).
CLOUDFLARED_BIN=cloudflared
TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# Optional: only relevant when the Bridge itself starts OpenCode in full-access mode.
OPENCODE_BIN=opencode
OPENCODE_BRIDGE_OPENCODE_HOST=127.0.0.1
OPENCODE_BRIDGE_OPENCODE_PORT_START=4096
# OPENCODE_BRIDGE_DEFAULT_MODEL=provider/model
